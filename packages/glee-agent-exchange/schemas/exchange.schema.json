{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glee.example/schemas/agent-exchange-v1.json",
  "title": "GLEE Agent Exchange record",
  "oneOf": [
    {"$ref": "#/$defs/task"},
    {"$ref": "#/$defs/message"},
    {"$ref": "#/$defs/ack"},
    {"$ref": "#/$defs/receipt"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "task": {
      "type": "object",
      "required": ["schema", "task_id", "from", "to", "goal", "acceptance", "created_at"],
      "properties": {
        "schema": {"const": "glee.exchange.task.v1"},
        "task_id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "goal": {"type": "string", "minLength": 1},
        "acceptance": {"type": "array", "items": {"type": "string"}},
        "created_at": {"type": "string"},
        "authority": {"type": "string"}
      }
    },
    "message": {
      "type": "object",
      "required": ["schema", "message_id", "task_id", "from", "to", "files", "created_at"],
      "properties": {
        "schema": {"const": "glee.exchange.message.v1"},
        "message_id": {"$ref": "#/$defs/id"},
        "task_id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "files": {"type": "array", "minItems": 1},
        "created_at": {"type": "string"}
      }
    },
    "ack": {
      "type": "object",
      "required": ["schema", "task_id", "message_id", "agent", "acked_at", "manifest_sha256"],
      "properties": {"schema": {"const": "glee.exchange.ack.v1"}}
    },
    "receipt": {
      "type": "object",
      "required": ["schema", "receipt_id", "task_id", "agent", "status", "summary", "evidence", "created_at"],
      "properties": {
        "schema": {"const": "glee.exchange.receipt.v1"},
        "status": {"enum": ["working", "blocked", "review", "accepted", "rejected"]}
      }
    }
  }
}
